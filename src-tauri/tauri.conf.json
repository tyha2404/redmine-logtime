{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redmine Logtime",
  "version": "0.6.1",
  "identifier": "app.redmine-logtime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Redmine Logtime",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    },
    "shortDescription": "Lịch logtime Redmine, nhập báo cáo bằng AI",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQUZDRDc4MkJEMDhCMEMKUldRTWk5QXJlTTJ2MHM5ckpqOWg5TDV0MGNmUU5lZHFqOTQyWFl1ZDlYUlJMalhjOU1BY2F0RnYK",
      "endpoints": [
        "https://github.com/tyha2404/redmine-logtime/releases/latest/download/latest.json"
      ]
    }
  }
}
